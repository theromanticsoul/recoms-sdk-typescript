{
    "name": "@recoms/sdk",
    "version": "0.2.3",
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/theromanticsoul/recoms-sdk-typescript.git"
    },
    "license": "MIT",
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.mjs",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.mts",
                "default": "./dist/esm/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            },
            "default": "./dist/cjs/index.js"
        },
        "./serialization": {
            "import": {
                "types": "./dist/esm/serialization/index.d.mts",
                "default": "./dist/esm/serialization/index.mjs"
            },
            "require": {
                "types": "./dist/cjs/serialization/index.d.ts",
                "default": "./dist/cjs/serialization/index.js"
            },
            "default": "./dist/cjs/serialization/index.js"
        },
        "./resources": {
            "import": {
                "types": "./dist/esm/api/resources/resources/exports.d.mts",
                "default": "./dist/esm/api/resources/resources/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/resources/exports.d.ts",
                "default": "./dist/cjs/api/resources/resources/exports.js"
            },
            "default": "./dist/cjs/api/resources/resources/exports.js"
        },
        "./comments": {
            "import": {
                "types": "./dist/esm/api/resources/comments/exports.d.mts",
                "default": "./dist/esm/api/resources/comments/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/comments/exports.d.ts",
                "default": "./dist/cjs/api/resources/comments/exports.js"
            },
            "default": "./dist/cjs/api/resources/comments/exports.js"
        },
        "./reactions": {
            "import": {
                "types": "./dist/esm/api/resources/reactions/exports.d.mts",
                "default": "./dist/esm/api/resources/reactions/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/reactions/exports.d.ts",
                "default": "./dist/cjs/api/resources/reactions/exports.js"
            },
            "default": "./dist/cjs/api/resources/reactions/exports.js"
        },
        "./project": {
            "import": {
                "types": "./dist/esm/api/resources/project/exports.d.mts",
                "default": "./dist/esm/api/resources/project/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/project/exports.d.ts",
                "default": "./dist/cjs/api/resources/project/exports.js"
            },
            "default": "./dist/cjs/api/resources/project/exports.js"
        },
        "./dashboard": {
            "import": {
                "types": "./dist/esm/api/resources/dashboard/exports.d.mts",
                "default": "./dist/esm/api/resources/dashboard/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/dashboard/exports.d.ts",
                "default": "./dist/cjs/api/resources/dashboard/exports.js"
            },
            "default": "./dist/cjs/api/resources/dashboard/exports.js"
        },
        "./me": {
            "import": {
                "types": "./dist/esm/api/resources/me/exports.d.mts",
                "default": "./dist/esm/api/resources/me/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/me/exports.d.ts",
                "default": "./dist/cjs/api/resources/me/exports.js"
            },
            "default": "./dist/cjs/api/resources/me/exports.js"
        },
        "./me/reactions": {
            "import": {
                "types": "./dist/esm/api/resources/me/resources/reactions/exports.d.mts",
                "default": "./dist/esm/api/resources/me/resources/reactions/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/me/resources/reactions/exports.d.ts",
                "default": "./dist/cjs/api/resources/me/resources/reactions/exports.js"
            },
            "default": "./dist/cjs/api/resources/me/resources/reactions/exports.js"
        },
        "./me/comments": {
            "import": {
                "types": "./dist/esm/api/resources/me/resources/comments/exports.d.mts",
                "default": "./dist/esm/api/resources/me/resources/comments/exports.mjs"
            },
            "require": {
                "types": "./dist/cjs/api/resources/me/resources/comments/exports.d.ts",
                "default": "./dist/cjs/api/resources/me/resources/comments/exports.js"
            },
            "default": "./dist/cjs/api/resources/me/resources/comments/exports.js"
